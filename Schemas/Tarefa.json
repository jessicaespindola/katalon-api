{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titulo", "feita"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "feita": {
      "type": "boolean"
    }
  }
}
